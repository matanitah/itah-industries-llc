# Example Cloudflare Tunnel config. Copy to secrets/cloudflared.yml (gitignored).
#
# tunnel: <TUNNEL_UUID>
# credentials-file: /absolute/path/to/<TUNNEL_UUID>.json
#
# ingress:
#   - hostname: spark-origin.example.com
#     service: http://127.0.0.1:8080
#   - service: http_status:404

tunnel: REPLACE_TUNNEL_UUID
credentials-file: REPLACE_CREDENTIALS_JSON_PATH

ingress:
  - hostname: spark-origin.example.com
    service: http://127.0.0.1:8080
  - service: http_status:404
