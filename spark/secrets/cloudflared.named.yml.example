# Named Cloudflare Tunnel — GPU / portal origin only.
# Copy to secrets/cloudflared.named.yml (gitignored) and fill tunnel UUID + credentials path.
#
# matanitah.com / www.matanitah.com stay on GitHub Pages (always on).
# Only spark-origin.matanitah.com is routed through this tunnel:
#   /v1/*     → spark-gateway (API Gateway origin + capacity when admin is online)
#   /agents/* → spark-gateway direct-tunnel path for agent-spark dashboards
#               (bypasses API Gateway so Streamlit's WebSocket works — see
#               spark_gateway/routes/agents.py's module docstring)
#   /*        → Next.js customer portal
#
# Create DNS once:
#   cloudflared tunnel route dns itah-mac spark-origin.matanitah.com

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /Users/YOU/.cloudflared/REPLACE_WITH_TUNNEL_UUID.json

# NOTE: cloudflared's ingress `path` is matched as an unanchored regex against
# the request path, not a prefix -- "/agents/*" would also match "/api/agents"
# (since "agents" appears as a substring), silently sending Next.js's BFF
# routes to spark-gateway instead. Anchor with ^ and require the trailing
# slash so only genuine /v1/... and /agents/... requests match.
ingress:
  - hostname: spark-origin.matanitah.com
    path: ^/v1/.*
    service: http://127.0.0.1:8080
  - hostname: spark-origin.matanitah.com
    path: ^/agents/.*
    service: http://127.0.0.1:8080
  - hostname: spark-origin.matanitah.com
    service: http://127.0.0.1:3000
  - service: http_status:404
