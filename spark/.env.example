# Spark gateway local config. Copy to .env and adjust.

HOST=127.0.0.1
PORT=8080

OLLAMA_BASE_URL=http://127.0.0.1:11434
# Any installed Ollama model. Leave empty to auto-pick the first local model.
OLLAMA_MODEL=llama3.2:latest

DOCLING_BASE_URL=http://127.0.0.1:5001

# Set the same value on API Gateway → origin requests (Terraform variable).
EDGE_SHARED_TOKEN=

AWS_REGION=us-east-1
DYNAMODB_CUSTOMERS_TABLE=itah-customers
DYNAMODB_API_KEYS_TABLE=itah-api-keys
DYNAMODB_ENTITLEMENTS_TABLE=itah-entitlements
DYNAMODB_SPARK_STATUS_TABLE=itah-spark-status
DYNAMODB_PORTAL_USERS_TABLE=itah-portal-users
DYNAMODB_PORTAL_INVITES_TABLE=itah-portal-invites
DYNAMODB_CUSTOMER_AGENTS_TABLE=itah-customer-agents

# agent-spark checkout on this box. Defaults to the sibling agent-spark/
# directory (i.e. this repo checked out normally); override if it lives
# elsewhere.
AGENT_SPARK_ROOT=
# Signs the short-lived tokens used by the agent-dashboard iframe direct-
# tunnel path (routes/agents.py). Falls back to EDGE_SHARED_TOKEN if unset;
# set a dedicated value in production.
AGENT_DASHBOARD_TOKEN_SECRET=
# Fine-grained GitHub PAT (Contents: Read and write, Metadata: Read-only,
# resource owner = itah-industries-wikis org, repository access = only the
# per-agent wiki repos) used by agent-spark to push each agent's shared
# wiki. Read here -- not just exported in a human's shell -- because
# spark-gateway is what actually launches the crawl-loop subprocess and
# passes this through explicitly (see services/agents.py).
AGENT_SPARK_GITHUB_TOKEN=

# Invite signup links point here (spark-origin portal host).
PORTAL_PUBLIC_BASE_URL=https://spark-origin.matanitah.com
# Optional: verified SES From address. If empty, admin UI shows the link to copy.
INVITE_FROM_EMAIL=
